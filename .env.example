PORT=8080
DATABASE_URL=postgres://picnic:picnic@127.0.0.1:4343/picnic?sslmode=disable
# Shared rate-limit buckets across API replicas. Empty = in-memory.
# REDIS_URL=redis://127.0.0.1:6379

# --- Postgres pool runtime settings (API/MCP; worker only takes lock_timeout) ---
# Per-connection GUCs so one slow query can't pin a pooled conn forever.
DB_STATEMENT_TIMEOUT=5s
# Worker batch jobs (ingest, scoring) need a larger per-statement budget.
DB_WORKER_STATEMENT_TIMEOUT=120s
DB_LOCK_TIMEOUT=2s
# DB_MAX_CONNS=0            # 0 = pgxpool default
# DB_JIT=off                # LLVM JIT costs ~0.2-1s/exec on high-cost plans; "on" re-enables

WEATHER_PROVIDER=open-meteo
# Self-hosted Open-Meteo (see docs/WEATHER_SELFHOST_PROPOSAL.md):
# OPEN_METEO_URL=http://localhost:8080/v1/forecast
# OPEN_METEO_MODELS=gfs_global   # required for self-host; empty = public best_match
# WEATHER_DAILY_LIMIT=0          # 0 disables the daily call quota (self-host)

# --- Environment ---
# APP_ENV=production puts Gin in release mode (an explicit GIN_MODE wins).
APP_ENV=development

# --- App Store (StoreKit 2 / Server Notifications V2) ---
# Required for POST /v1/entitlement/link and /v1/appstore/notifications.
# Unset = both endpoints answer 503 (fail closed); there is no bypass.
APPSTORE_BUNDLE_ID=
# Accept Sandbox payloads too (App Review buys in Sandbox against production).
# Sandbox subscriptions are free to create: default is true outside
# production, false when APP_ENV=production. Set true explicitly only for
# the App Review window.
APPSTORE_ALLOW_SANDBOX=
# Comma-separated App Store product IDs allowed to grant Plus
# (e.g. com.example.app.plus.monthly). Empty = every product in the bundle
# can grant Plus — set before go-live.
APPSTORE_PLUS_PRODUCT_IDS=

# --- HTTP edge ---
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For. Default: none, so
# the client IP is the socket peer. Behind a load balancer set the LB address
# (e.g. 10.0.0.0/8), otherwise every client shares the LB's rate-limit bucket.
TRUSTED_PROXIES=127.0.0.1,::1
# Default request body cap in bytes (POST /v1/events = 512 KiB and the App
# Store webhook = 256 KiB have fixed larger caps).
BODY_MAX_BYTES=65536
# Per-client-IP token buckets (requests/min, plus burst). /healthz and /readyz
# are exempt.
RATE_READ_PER_MIN=600
RATE_READ_BURST=120
RATE_WRITE_PER_MIN=60
RATE_WRITE_BURST=30
# POST /v1/devices (free identity minting) is the tightest.
RATE_DEVICE_PER_HOUR=30
RATE_DEVICE_BURST=10
# Failed admin / MCP authentications per IP before 429.
RATE_AUTH_FAIL_PER_MIN=10

# Share page + universal links (GET /s/{spotId}, /.well-known/apple-app-site-association).
# APPLE_APP_IDS: comma-separated "<TeamID>.<bundle id>"; empty = association file answers 404.
APPLE_APP_IDS=
# Numeric App Store id; enables the "Get the App" link on the share page.
APPSTORE_APP_ID=

# --- Admin console MFA (session login + TOTP) ---
# MFA_SECRET_KEYS_CLI is the bearer token for scripts/CI only — never type it
# into the browser.
# MFA_SECRET_KEYS seals TOTP secrets at rest: 32 random bytes, hex-encoded
# (generate: openssl rand -hex 32). Unset = account login disabled, bearer only.
MFA_SECRET_KEYS=
MFA_SECRET_KEYS_CLI=
# Extra Origin hosts allowed on mutating /v1/admin requests. The console's
# own origin is normally accepted via X-Forwarded-Host set by the web proxy.
ADMIN_ALLOWED_ORIGINS=
# Login-flow lifetimes and lockout (Go durations / count).
MFA_CHALLENGE_TTL=5m
MFA_SESSION_TTL=12h
MFA_SESSION_IDLE_TTL=30m
MFA_MAX_FAILURES=5
MFA_LOCKOUT_TTL=15m

# --- Admin console Google account link (Search Console + GA4 read) ---
# OAuth2 web client from GCP Console. All three must be set to enable the
# /security "Connect Google" flow; the refresh token is sealed with
# MFA_SECRET_KEYS at rest. GOOGLE_REDIRECT_URI must exactly match an
# authorized redirect URI on the OAuth client — point it at the console
# origin so the callback lands on /security, e.g.
#   http://localhost:3000/v1/admin/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MCP_PORT=8081
