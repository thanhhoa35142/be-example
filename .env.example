PORT=8080
DATABASE_URL=postgres://picnic:picnic@127.0.0.1:4343/picnic?sslmode=disable
# Shared rate-limit buckets across API replicas. Empty = in-memory.
# REDIS_URL=redis://127.0.0.1:6379

WEATHER_PROVIDER=open-meteo

# --- Environment ---
# APP_ENV=production puts Gin in release mode (an explicit GIN_MODE wins).
APP_ENV=development

# --- App Store (StoreKit 2 / Server Notifications V2) ---
# Required for POST /v1/entitlement/link and /v1/appstore/notifications.
# Unset = both endpoints answer 503 (fail closed); there is no bypass.
APPSTORE_BUNDLE_ID=
# Accept Sandbox payloads too (App Review buys in Sandbox against production).
# Sandbox subscriptions are free to create: set false once the app is live.
APPSTORE_ALLOW_SANDBOX=true

# --- HTTP edge ---
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For. Default: none, so
# the client IP is the socket peer. Behind a load balancer set the LB address
# (e.g. 10.0.0.0/8), otherwise every client shares the LB's rate-limit bucket.
TRUSTED_PROXIES=
# Default request body cap in bytes (POST /v1/events = 512 KiB and the App
# Store webhook = 256 KiB have fixed larger caps).
BODY_MAX_BYTES=65536
# Per-client-IP token buckets (requests/min, plus burst). /healthz and /readyz
# are exempt.
RATE_READ_PER_MIN=600
RATE_READ_BURST=120
RATE_WRITE_PER_MIN=60
RATE_WRITE_BURST=30
# POST /v1/devices (free identity minting) is the tightest.
RATE_DEVICE_PER_HOUR=30
RATE_DEVICE_BURST=10
# Failed admin / MCP authentications per IP before 429.
RATE_AUTH_FAIL_PER_MIN=10

# Share page + universal links (GET /s/{spotId}, /.well-known/apple-app-site-association).
# APPLE_APP_IDS: comma-separated "<TeamID>.<bundle id>"; empty = association file answers 404.
APPLE_APP_IDS=
# Numeric App Store id; enables the "Get the App" link on the share page.
APPSTORE_APP_ID=
